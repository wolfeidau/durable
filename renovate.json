{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    "schedule:weekdays",
    "group:allNonMajor"
  ],
  "labels": [
    "dependencies"
  ],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "minimumReleaseAge": "3 days",
  "vulnerabilityAlerts": {
    "labels": [
      "dependencies",
      "security"
    ],
    "minimumReleaseAge": "0 days",
    "enabled": true
  },
  "postUpdateOptions": [
    "gomodTidy",
    "gomodUpdateImportPaths"
  ],
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": true,
  "packageRules": [
    {
      "description": "Group Go minor and patch updates",
      "matchManagers": [
        "gomod"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "go-minor-patch"
    },
    {
      "description": "Group test and dev tooling",
      "matchPackageNames": [
        "github.com/stretchr/testify"
      ],
      "groupName": "testing"
    },
    {
      "description": "Group Buildkite plugins",
      "matchManagers": [
        "buildkite"
      ],
      "groupName": "buildkite-plugins"
    },
    {
      "description": "connectrpc.com only answers go-get for the module root, so look the codegen tool up by its module",
      "matchManagers": [
        "mise"
      ],
      "matchPackageNames": [
        "connectrpc.com/connect/cmd/protoc-gen-connect-go"
      ],
      "overridePackageName": "connectrpc.com/connect"
    },
    {
      "description": "Majors of modules coupled to generated code need regeneration and a planned migration, so they wait for approval on the dependency dashboard",
      "matchPackageNames": [
        "/(^|:)connectrpc\\.com/connect/",
        "/(^|:)google\\.golang\\.org/protobuf/"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Do not automerge major updates",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "description": "Dockerfile tool bumps need their checksums updated by hand, so they get their own PR and never automerge",
      "matchManagers": [
        "custom.regex"
      ],
      "groupName": "worker image tools",
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Release binaries pinned with a renovate comment in the worker Dockerfiles",
      "managerFilePatterns": [
        "/^docker/.+\\.Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+ARG \\w+_VERSION=(?<currentValue>\\S+)"
      ],
      "extractVersionTemplate": "^v(?<version>.+)$"
    }
  ]
}
